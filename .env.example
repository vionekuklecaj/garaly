# Copy this file to .env and fill in real values. Never commit .env.

# Postgres connection (async, used by the app)
DATABASE_URL=sqlite+aiosqlite:///./garaly.db

# Postgres connection (sync, used by Alembic migrations)
DATABASE_URL_SYNC=postgresql+psycopg2://garaly:garaly@localhost:5432/garaly

# Random long secret, e.g. generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-value

# Session cookie lifetime in seconds (default: 30 days)
SESSION_MAX_AGE=2592000

# Set to true only when serving over HTTPS in production
COOKIE_SECURE=false

ENVIRONMENT=development
